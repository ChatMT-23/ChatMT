# Personal diary: it lives one level above this repository (Chatmt/diario.md), so git never
# sees it anyway. The entry is here so that a copy of it can never be committed by mistake.
diario.md

# Installed dependencies (jimp for the backend image operations).
node_modules/

# Backend data: one JSON profile per user. Local data, never committed.
data/

# Local secrets: never commit an API key. The template is the one exception: it holds no key
# and it is what tells the next person which variables exist.
.env
.env.*
!.env.example
.gstack/

.vercel
.env*
