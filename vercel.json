{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/frontend", "destination": "/index.html" },
    { "source": "/frontend/(.*)", "destination": "/$1" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "standards/**"
    }
  }
}
